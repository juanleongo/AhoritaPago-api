PORT=3000
DATABASE_URL=mongodb://127.0.0.1:27017/ahoritapago?replicaSet=rs0
# Debe reemplazarse: la aplicación rechaza este valor de ejemplo.
JWT_SECRET=reemplazar-con-un-secreto-largo-y-aleatorio

CORS_ALLOW_LOCALHOST=true
CORS_ALLOWED_ORIGINS=
JSON_BODY_LIMIT=100kb

RATE_LIMIT_ENABLED=false
TRUST_PROXY_HOPS=0
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX=500
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=15
REGISTRATION_RATE_LIMIT_WINDOW_MS=3600000
REGISTRATION_RATE_LIMIT_MAX=10
